<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RadioFreeDAM.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RadioFreeDAM.Views"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Shell.FlyoutBehavior="{OnPlatform WinUI=Locked, Default=Disabled}"
    Shell.FlyoutWidth="220"
    FlyoutBackground="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
    Title="RadioFreeDAM">

    <!-- Barra de estado del móvil del mismo color que la app, con iconos legibles en cada tema -->
    <Shell.Behaviors>
        <toolkit:StatusBarBehavior
            StatusBarColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </Shell.Behaviors>

    <!-- Same three sections everywhere: bottom tabs on a phone, side bar on Windows (the flyout shows each one as an item). -->
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems" Shell.TabBarIsVisible="{OnPlatform WinUI=False, Default=True}">
        <ShellContent
            Title="Inicio"
            Icon="{StaticResource IconHome}"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home"
            SemanticProperties.Description="Inicio"
            SemanticProperties.Hint="Ver el listado de emisoras" />

        <ShellContent
            Title="Reproductor"
            Icon="{StaticResource IconPlayer}"
            ContentTemplate="{DataTemplate views:PlayerPage}"
            Route="player"
            SemanticProperties.Description="Reproductor"
            SemanticProperties.Hint="Ver la emisora seleccionada" />

        <ShellContent
            Title="Favoritos"
            Icon="{StaticResource IconFavorites}"
            ContentTemplate="{DataTemplate views:FavoritesPage}"
            Route="favorites"
            SemanticProperties.Description="Favoritos"
            SemanticProperties.Hint="Ver tus emisoras favoritas" />
    </FlyoutItem>

</Shell>
