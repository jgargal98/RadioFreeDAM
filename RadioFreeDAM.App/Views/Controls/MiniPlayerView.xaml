<?xml version="1.0" encoding="utf-8" ?>
<!--
    Mini reproductor: barra fija sobre las pestañas en Inicio y Favoritos.
    Usa el mismo PlayerViewModel que la pantalla Reproductor, así que siempre muestra lo mismo.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:vm="clr-namespace:RadioFreeDAM.ViewModels"
             xmlns:controls="clr-namespace:RadioFreeDAM.Views.Controls"
             x:Class="RadioFreeDAM.Views.Controls.MiniPlayerView"
             x:DataType="vm:PlayerViewModel"
             IsVisible="{Binding HasStation}">

    <Border StrokeThickness="0"
            StrokeShape="Rectangle"
            Padding="16,10"
            Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
            SemanticProperties.Description="Mini reproductor. Toca para abrir el reproductor">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.15" Radius="8" Offset="0,-2" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding GoToPlayerCommand}" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <!-- Logo o inicial -->
            <controls:StationLogoView WidthRequest="44" HeightRequest="44" Source="{Binding CurrentStation.FaviconUrl}" Initial="{Binding StationInitial}" InitialFontSize="20" />

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding CurrentStation.Name}" Style="{StaticResource Body1Strong}" LineBreakMode="TailTruncation" />
                <HorizontalStackLayout Spacing="6">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       WidthRequest="14" HeightRequest="14" Color="{DynamicResource Primary}" />
                    <Label Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="13">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Reproducir / detener sin salir de la pantalla -->
            <ImageButton Grid.Column="2"
                         Command="{Binding TogglePlaybackCommand}"
                         WidthRequest="44" HeightRequest="44"
                         CornerRadius="22" Padding="10"
                         Background="{DynamicResource PrimaryBrush}"
                         VerticalOptions="Center"
                         SemanticProperties.Description="{Binding ToggleButtonText}">
                <ImageButton.Source>
                    <FontImageSource Glyph="{x:Static f:FluentUI.play_24_regular}"
                                     FontFamily="{x:Static f:FluentUI.FontFamily}"
                                     Color="{DynamicResource OnPrimary}" Size="24" />
                </ImageButton.Source>
                <ImageButton.Triggers>
                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Source">
                            <FontImageSource Glyph="{x:Static f:FluentUI.stop_24_regular}"
                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                             Color="{DynamicResource OnPrimary}" Size="24" />
                        </Setter>
                    </DataTrigger>
                </ImageButton.Triggers>
            </ImageButton>
        </Grid>
    </Border>
</ContentView>
