<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:vm="clr-namespace:RadioFreeDAM.ViewModels"
             xmlns:controls="clr-namespace:RadioFreeDAM.Views.Controls"
             x:Class="RadioFreeDAM.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Shell.NavBarIsVisible="False"
             Title="Favoritos">

    <Grid RowDefinitions="*,Auto">
        <!-- Sin sesión: invitación a iniciarla -->
        <VerticalStackLayout IsVisible="{Binding IsLoggedOut}"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Padding="{StaticResource LayoutPadding}"
                             Spacing="12" MaximumWidthRequest="360">
            <Image Source="{StaticResource IconFavorites}" WidthRequest="48" HeightRequest="48" />
            <Label Text="Guarda tus emisoras favoritas" Style="{StaticResource Title2}" HorizontalTextAlignment="Center" />
            <Label Text="Inicia sesión para guardarlas y recuperarlas cuando vuelvas a abrir la app."
                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            <Button Text="Iniciar sesión" Command="{Binding LoginCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Con sesión: lista de favoritas -->
        <Grid IsVisible="{Binding IsLoggedIn}"
              RowDefinitions="Auto,Auto,*"
              Padding="{StaticResource LayoutPadding}"
              RowSpacing="{StaticResource LayoutSpacing}">

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                <Label Text="Favoritos" Style="{StaticResource Title1}" />
                <Label Grid.Row="1" Text="{Binding UserText}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                <!-- Ajustes: ahí se cierra la sesión -->
                <ImageButton Grid.RowSpan="2" Grid.Column="1"
                             Command="{Binding OpenSettingsCommand}"
                             WidthRequest="44" HeightRequest="44" Padding="10"
                             Background="Transparent" VerticalOptions="Center"
                             SemanticProperties.Description="Ajustes">
                    <ImageButton.Source>
                        <FontImageSource Glyph="{x:Static f:FluentUI.settings_24_regular}"
                                         FontFamily="{x:Static f:FluentUI.FontFamily}"
                                         Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                         Size="24" />
                    </ImageButton.Source>
                </ImageButton>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" IsVisible="{Binding HasError}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    <Button Text="Reintentar" Style="{StaticResource OutlineButton}" HorizontalOptions="Start"
                            Command="{Binding LoadCommand}" />
                </VerticalStackLayout>
            </Border>

            <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                             Spacing="12" MaximumWidthRequest="360" Padding="0,40">
                            <Label Text="Aún no tienes favoritas" Style="{StaticResource Title2}" HorizontalTextAlignment="Center" />
                            <Label Text="Abre una emisora en el Reproductor y pulsa «Añadir a favoritas»."
                                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FavoriteItemViewModel">
                            <Border Style="{StaticResource CardStyle}" SemanticProperties.Description="{Binding Name}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding PlayCommand, Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, x:DataType=vm:FavoritesViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Grid WidthRequest="48" HeightRequest="48">
                                        <Border Style="{StaticResource StationAvatarStyle}"
                                                IsVisible="{Binding HasFavicon, Converter={StaticResource InvertedBoolConverter}}">
                                            <Label Text="{Binding Initial}"
                                                   TextColor="{DynamicResource OnPrimary}"
                                                   FontSize="22" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Border Style="{StaticResource StationLogoStyle}" IsVisible="{Binding HasFavicon}">
                                            <Image Source="{Binding FaviconUrl}" Aspect="AspectFit" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource Body1Strong}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="Sonando"
                                           IsVisible="{Binding IsPlaying}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource PrimaryText}"
                                           VerticalOptions="Center" />

                                    <ImageButton Grid.Column="3"
                                                 Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, x:DataType=vm:FavoritesViewModel}"
                                                 CommandParameter="{Binding .}"
                                                 WidthRequest="40" HeightRequest="40" Padding="8"
                                                 Background="Transparent"
                                                 SemanticProperties.Description="Quitar de favoritas">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="{x:Static f:FluentUI.delete_24_regular}"
                                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                             Color="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}"
                                                             Size="22" />
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Mini reproductor (su BindingContext lo pone el código de la página) -->
        <controls:MiniPlayerView x:Name="MiniPlayer" Grid.Row="1" />
    </Grid>
</ContentPage>
