<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:vm="clr-namespace:RadioFreeDAM.ViewModels"
             xmlns:controls="clr-namespace:RadioFreeDAM.Views.Controls"
             x:Class="RadioFreeDAM.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             Title="Inicio">

  <Grid RowDefinitions="*,Auto">

    <!-- Everything scrolls together: the header (greeting, search, filters) is the header of the list -->
    <Grid Padding="{StaticResource LayoutPadding}">
      <CollectionView ItemsSource="{Binding Stations}" SelectionMode="None">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Spacing="12" Padding="0,0,0,12">

                <!-- Search and settings: the only things always visible above the list -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <SearchBar Placeholder="Buscar emisora"
                               Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchCommand}"
                               SemanticProperties.Hint="Escribe el nombre de una emisora; los resultados aparecen solos" />
                    <ImageButton Grid.Column="1"
                                 Command="{Binding OpenSettingsCommand}"
                                 WidthRequest="44" HeightRequest="44" Padding="10"
                                 Background="Transparent" VerticalOptions="Center"
                                 SemanticProperties.Description="Ajustes">
                        <ImageButton.Source>
                            <FontImageSource Glyph="{x:Static f:FluentUI.settings_24_regular}"
                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                             Size="24" />
                        </ImageButton.Source>
                    </ImageButton>
                </Grid>

                <!-- Filters: three drop-down menus. Each shows the chosen option and opens its list when tapped -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource FilterChipStyle}" SemanticProperties.Description="Ámbito">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseScopeCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding ScopeText}" FontSize="15" VerticalOptions="Center" />
                                <Label Text="{x:Static f:FluentUI.chevron_down_20_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}"
                                       FontSize="18" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource FilterChipStyle}" SemanticProperties.Description="Categoría">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseCategoryCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding CategoryText}" FontSize="15" VerticalOptions="Center" />
                                <Label Text="{x:Static f:FluentUI.chevron_down_20_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}"
                                       FontSize="18" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource FilterChipStyle}" SemanticProperties.Description="Orden">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseSortCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding SortText}" FontSize="15" VerticalOptions="Center" />
                                <Label Text="{x:Static f:FluentUI.chevron_down_20_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}"
                                       FontSize="18" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Error: only appears when something fails, with a retry button -->
                <Border Style="{StaticResource CardStyle}" IsVisible="{Binding HasError}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                        <Button Text="Reintentar" Style="{StaticResource OutlineButton}" HorizontalOptions="Start"
                                Command="{Binding RefreshCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- One quiet line: what is shown and how many; reset only when filters are active -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding ListSummary}" Style="{StaticResource Muted}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <Button Grid.Column="1" Text="Restablecer" Style="{StaticResource TextButton}"
                            IsVisible="{Binding HasActiveFilters}" Command="{Binding ResetFiltersCommand}" />
                </Grid>
            </VerticalStackLayout>
        </CollectionView.Header>

        <!-- Empty list: search or filters without results -->
        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="0,40" Spacing="8" HorizontalOptions="Center" MaximumWidthRequest="360">
                <Label Text="{Binding EmptyMessage}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:StationItemViewModel">
                <Border Style="{StaticResource CardStyle}" SemanticProperties.Description="{Binding Name}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <!-- Single properties are changed (not the whole Style) so they are restored when deselected -->
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                            <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectStationCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <!-- Station logo; the initial on the accent color if it has none -->
                        <controls:StationLogoView WidthRequest="48" HeightRequest="48" Source="{Binding FaviconUrl}" Initial="{Binding Initial}" />

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Name}" Style="{StaticResource Body1Strong}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2" Text="Sonando" IsVisible="{Binding IsPlaying}"
                               FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryText}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                         HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,24"
                         Color="{DynamicResource Primary}" />
    </Grid>

    <!-- Mini player (its BindingContext is set by the page code) -->
    <controls:MiniPlayerView x:Name="MiniPlayer" Grid.Row="1" />
  </Grid>
</ContentPage>
