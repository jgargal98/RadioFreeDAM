<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RadioFreeDAM.ViewModels"
             x:Class="RadioFreeDAM.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Crear cuenta">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="16"
                             MaximumWidthRequest="420" VerticalOptions="Center">

            <VerticalStackLayout Spacing="4">
                <Label Text="Crear cuenta" Style="{StaticResource Title1}" />
                <Label Text="Tus favoritas se guardarán en tu cuenta." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Nombre" Style="{StaticResource Body1Strong}" />
                <Entry Text="{Binding Name}" Placeholder="Cómo quieres que te llamemos" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Correo" Style="{StaticResource Body1Strong}" />
                <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="tu@correo.com"
                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Contraseña" Style="{StaticResource Body1Strong}" />
                <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Mínimo 8 caracteres" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Repite la contraseña" Style="{StaticResource Body1Strong}" />
                <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="La misma contraseña"
                       ReturnCommand="{Binding RegisterCommand}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="4">
                <CheckBox IsChecked="{Binding RememberMe}" Color="{DynamicResource Primary}" VerticalOptions="Center" />
                <Label Text="Mantener la sesión iniciada" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRememberLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <Border Style="{StaticResource CardStyle}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <Grid>
                <Button Text="Crear cuenta" Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   WidthRequest="24" HeightRequest="24" Color="{DynamicResource OnPrimary}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
