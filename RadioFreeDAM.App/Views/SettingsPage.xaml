<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:vm="clr-namespace:RadioFreeDAM.ViewModels"
             xmlns:controls="clr-namespace:RadioFreeDAM.Views.Controls"
             x:Class="RadioFreeDAM.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             Title="Ajustes">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="10"
                             MaximumWidthRequest="560">

            <!-- Cabecera propia con flecha de volver (en lugar de la barra de navegación nativa) -->
            <controls:BackHeaderView Title="Ajustes" Margin="0,0,0,8" />

            <!-- ===== Cuenta ===== -->
            <Label Text="Cuenta" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- Con sesión -->
                    <Grid IsVisible="{Binding IsLoggedIn}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource StationAvatarStyle}" StrokeShape="RoundRectangle 22"
                                WidthRequest="44" HeightRequest="44">
                            <Label Text="{Binding UserInitial}" TextColor="{DynamicResource OnPrimary}"
                                   FontSize="20" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding UserName}" Style="{StaticResource Body1Strong}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding UserEmail}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Cerrar sesión" Style="{StaticResource OutlineButton}"
                                VerticalOptions="Center" Command="{Binding LogoutCommand}" />
                    </Grid>

                    <!-- Sin sesión -->
                    <Grid IsVisible="{Binding IsLoggedOut}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="No has iniciado sesión" Style="{StaticResource Body1Strong}" />
                            <Label Text="Inicia sesión para guardar tus favoritas." Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Iniciar sesión" VerticalOptions="Center"
                                Command="{Binding LoginCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Tema ===== -->
            <Label Text="Tema" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />

            <Border Style="{StaticResource CardStyle}" Padding="6">
                <FlexLayout BindableLayout.ItemsSource="{Binding ThemeOptions}" JustifyContent="SpaceEvenly">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                            <Border FlexLayout.Grow="1" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    Padding="8,10" Background="Transparent"
                                    SemanticProperties.Description="{Binding Label}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectThemeCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" HorizontalTextAlignment="Center" FontSize="15">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Border>

            <!-- ===== Color de acento ===== -->
            <Label Text="Color de acento" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">

                    <!-- Color de la emisora -->
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1.5" Padding="12,10"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            SemanticProperties.Description="Usar el color de la emisora">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsStationAccent}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectStationAccentCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Color de la emisora" Style="{StaticResource Body1Strong}" />
                                <Label Text="Cambia según lo que suena. Sin emisora o sin logo, verde."
                                       Style="{StaticResource Muted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{x:Static f:FluentUI.checkmark_24_regular}"
                                   FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="24"
                                   TextColor="{DynamicResource PrimaryText}" VerticalOptions="Center"
                                   IsVisible="{Binding IsStationAccent}" />
                        </Grid>
                    </Border>

                    <!-- Colores fijos -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="O elige un color fijo" Style="{StaticResource Muted}" />
                        <!-- Fila normal: FlexLayout con Wrap calcula mal la altura en Android -->
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Presets}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccentPresetViewModel">
                                    <Grid WidthRequest="48" HeightRequest="48"
                                          SemanticProperties.Description="{Binding Name}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectPresetCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <!-- Anillo de selección -->
                                        <Ellipse Stroke="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                 StrokeThickness="2.5" IsVisible="{Binding IsSelected}" />
                                        <Ellipse Fill="{Binding Color}" Margin="5" />
                                        <Label Text="{x:Static f:FluentUI.checkmark_20_regular}"
                                               FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20"
                                               TextColor="White" IsVisible="{Binding IsSelected}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Barra de tono: cualquier color; la app fija saturación y brillo para que se lea bien -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="O desliza para elegir cualquier tono" Style="{StaticResource Muted}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Grid HeightRequest="40">
                                <Border HeightRequest="14" VerticalOptions="Center" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 7" Margin="10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#CA2B2B" Offset="0" />
                                            <GradientStop Color="#CACA2B" Offset="0.1667" />
                                            <GradientStop Color="#2BCA2B" Offset="0.3333" />
                                            <GradientStop Color="#2BCACA" Offset="0.5" />
                                            <GradientStop Color="#2B2BCA" Offset="0.6667" />
                                            <GradientStop Color="#CA2BCA" Offset="0.8333" />
                                            <GradientStop Color="#CA2B2B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Slider Minimum="0" Maximum="360" Value="{Binding Hue}"
                                        MinimumTrackColor="Transparent" MaximumTrackColor="Transparent"
                                        ThumbColor="{Binding HuePreview}"
                                        SemanticProperties.Description="Tono del color de acento" />
                            </Grid>
                            <!-- Muestra del tono; con anillo si es el acento activo -->
                            <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40">
                                <Ellipse Stroke="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                         StrokeThickness="2.5" IsVisible="{Binding IsHueAccent}" />
                                <Ellipse Fill="{Binding HuePreview}" Margin="5" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
